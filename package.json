{
    "name": "fluiggers-fluig-vscode-extension",
    "displayName": "Fluig - Extensão para Desenvolvimento",
    "description": "Extensão para agilizar o desenvolvimento para o TOTVS Fluig no VS Code",
    "version": "2.12.0",
    "publisher": "Fluiggers",
    "activationEvents": [
        "workspaceContains:**/*.process",
        "onCustomEditor:fluigBpmn.processEditor",
        "onCommand:fluigBpmn.openText",
        "onCommand:fluigBpmn.validate",
        "onCommand:fluigBpmn.generateTranslations",
        "onCommand:fluiggers-fluig-vscode-extension.newWorkflowProcess"
    ],
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/fluiggers/fluig-vscode-extension"
    },
    "author": {
        "name": "Bruno Gasparetto",
        "email": "brunogasparetto@gmail.com",
        "url": "https://github.com/brunogasparetto"
    },
    "contributors": [
        {
            "name": "Pedro Costa",
            "url": "https://github.com/pedro-costa-neto"
        },
        {
            "name": "Bruno Araujo",
            "url": "https://github.com/brunotda"
        },
        {
            "name": "Jhonatan Serafim",
            "url": "https://github.com/jhonnytuba"
        }
    ],
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Snippets",
        "Programming Languages",
        "Other"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "customEditors": [
            {
                "viewType": "fluigBpmn.processEditor",
                "displayName": "Fluig BPMN",
                "selector": [
                    {
                        "filenamePattern": "*.process"
                    }
                ],
                "priority": "default"
            }
        ],
        "commands": [
            {
                "command": "fluiggers-fluig-vscode-extension.installDeclarationLibrary",
                "title": "Instalar Declarações de Tipo",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newDataset",
                "title": "Novo Dataset",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newForm",
                "title": "Novo Formulário",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newFormEvent",
                "title": "Novo Evento de Formulário",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newWorkflowProcess",
                "title": "Novo Diagrama de Processo",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newWorkflowEvent",
                "title": "Novo Evento de Processo",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportWorkflowEvent",
                "title": "Exportar Evento de Processo",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.generateWorkflowProcessArtifact",
                "title": "Gerar ECM30 do Processo",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.validateWorkflowProcessExport",
                "title": "Validar Exportacao de Processo",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportWorkflowProcess",
                "title": "Exportar Processo",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newGlobalEvent",
                "title": "Novo Evento Global",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportGlobalEvent",
                "title": "Exportar Evento Global",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.deleteGlobalEvent",
                "title": "Excluir Evento Global",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newMechanism",
                "title": "Novo Mecanismo Customizado",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.importManyMechanisms",
                "title": "Importar Vários Mecanismos Customizados",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.importMechanism",
                "title": "Importar Mecanismo Customizado",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportMechanism",
                "title": "Exportar Mecanismo Customizado",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newWidget",
                "title": "Novo Widget",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportWidget",
                "title": "Exportar Widget",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.importWidget",
                "title": "Importar Widget",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportFluiggersWidget",
                "title": "Exportar Fluiggers Widget",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.addServer",
                "title": "Adicionar Servidor",
                "category": "Fluig",
                "icon": {
                    "light": "dist/images/light/add.svg",
                    "dark": "dist/images/dark/add.svg"
                }
            },
            {
                "command": "fluiggers-fluig-vscode-extension.changeServerConfigPath",
                "title": "Alterar Caminho para o Arquivo de Configuração de Servidores",
                "category": "Fluig",
                "icon": {
                    "light": "dist/images/light/edit.svg",
                    "dark": "dist/images/dark/edit.svg"
                }
            },
            {
                "command": "fluiggers-fluig-vscode-extension.deleteServer",
                "title": "Excluir Servidor",
                "category": "Fluig",
                "icon": {
                    "light": "dist/images/light/trash.svg",
                    "dark": "dist/images/dark/trash.svg"
                }
            },
            {
                "command": "fluiggers-fluig-vscode-extension.refreshServer",
                "title": "Atualizar",
                "category": "Fluig",
                "icon": {
                    "light": "dist/images/light/refresh.svg",
                    "dark": "dist/images/dark/refresh.svg"
                }
            },
            {
                "command": "fluiggers-fluig-vscode-extension.editServer",
                "title": "Editar Servidor",
                "category": "Fluig",
                "icon": {
                    "light": "dist/images/light/edit.svg",
                    "dark": "dist/images/dark/edit.svg"
                }
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportDataset",
                "title": "Exportar Dataset",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportDatasetFolder",
                "title": "Exportar Datasets da Pasta",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.importDataset",
                "title": "Importar Dataset",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.importManyDataset",
                "title": "Importar Vários Datasets",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.searchDataset",
                "title": "Consultar Dataset",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.importForm",
                "title": "Importar Formulário",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.importManyForm",
                "title": "Importar Vários Formulários",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportForm",
                "title": "Exportar Formulário",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.importGlobalEvent",
                "title": "Importar Evento Global",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.importManyGlobalEvent",
                "title": "Importar Vários Eventos Globais",
                "category": "Fluig"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.datasetView",
                "title": "Consultar Dataset",
                "category": "Fluig",
                "icon": {
                    "light": "dist/images/light/preview.svg",
                    "dark": "dist/images/dark/preview.svg"
                }
            },
            {
                "command": "fluigBpmn.openText",
                "title": "Abrir processo como texto",
                "category": "Fluig BPMN"
            },
            {
                "command": "fluigBpmn.validate",
                "title": "Validar processo",
                "category": "Fluig BPMN"
            },
            {
                "command": "fluigBpmn.generateTranslations",
                "title": "Gerar arquivos de tradução",
                "category": "Fluig BPMN"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "fluiggers-fluig-vscode-extension.newFormEvent",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.newWorkflowEvent",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportWorkflowEvent",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportDataset",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportGlobalEvent",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportMechanism",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportForm",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportWidget",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.deleteServer",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.editServer",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.datasetView",
                    "when": "false"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportDatasetFolder",
                    "when": "explorerResourceIsFolder"
                }
            ],
            "explorer/context": [
                {
                    "command": "fluiggers-fluig-vscode-extension.newWorkflowProcess",
                    "when": "explorerResourceIsFolder",
                    "group": "1_Fluig4Workflow@0"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.newDataset",
                    "group": "1_Fluig1Dataset@1"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportDataset",
                    "when": "resourcePath =~ /[\\/\\\\]datasets[\\/\\\\].+$/",
                    "group": "1_Fluig1Dataset@2"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportDatasetFolder",
                    "when": "explorerResourceIsFolder && resourcePath =~ /.*[\\/\\\\]datasets[\\/\\\\]?.*/",
                    "group": "1_Fluig1Dataset@3"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.importDataset",
                    "group": "1_Fluig1Dataset@4"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.importManyDataset",
                    "group": "1_Fluig1Dataset@5"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.searchDataset",
                    "group": "1_Fluig1Dataset@6"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.newForm",
                    "group": "1_Fluig2Form@1"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.newFormEvent",
                    "when": "resourcePath =~ /[\\/\\\\]forms[\\/\\\\].+$/",
                    "group": "1_Fluig2Form@2"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.importManyForm",
                    "group": "1_Fluig2Form@3"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.importForm",
                    "group": "1_Fluig2Form@4"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportForm",
                    "when": "resourcePath =~ /[\\/\\\\]forms[\\/\\\\].+$/",
                    "group": "1_Fluig2Form@5"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportGlobalEvent",
                    "when": "resourcePath =~ /[\\/\\\\]events[\\/\\\\].+$/",
                    "group": "1_Fluig3GlobalEvent@1"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.newGlobalEvent",
                    "group": "1_Fluig3GlobalEvent@2"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.importManyGlobalEvent",
                    "group": "1_Fluig3GlobalEvent@3"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.importGlobalEvent",
                    "group": "1_Fluig3GlobalEvent@4"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.newWorkflowEvent",
                    "when": "resourceExtname == .process || resourcePath =~ /[\\/\\\\]workflow[\\/\\\\]scripts[\\/\\\\].+\\.js$/",
                    "group": "1_Fluig4Workflow@1"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportWorkflowEvent",
                    "when": "resourcePath =~ /[\\/\\\\]workflow[\\/\\\\]scripts[\\/\\\\].+\\.js$/",
                    "group": "1_Fluig4Workflow@2"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.generateWorkflowProcessArtifact",
                    "when": "resourceExtname == .process",
                    "group": "1_Fluig4Workflow@3"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.validateWorkflowProcessExport",
                    "when": "resourceExtname == .process",
                    "group": "1_Fluig4Workflow@4"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportWorkflowProcess",
                    "when": "resourceExtname == .process",
                    "group": "1_Fluig4Workflow@5"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportMechanism",
                    "when": "resourcePath =~ /[\\/\\\\]mechanisms[\\/\\\\].+$/",
                    "group": "1_Fluig4Workflow@6"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.newMechanism",
                    "group": "1_Fluig4Workflow@7"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.importManyMechanisms",
                    "group": "1_Fluig4Workflow@8"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.importMechanism",
                    "group": "1_Fluig4Workflow@9"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.newWidget",
                    "group": "1_Fluig5WCM@1"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.exportWidget",
                    "when": "resourcePath =~ /[\\/\\\\]widget[\\/\\\\].+$/",
                    "group": "1_Fluig5WCM@2"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.importWidget",
                    "group": "1_Fluig5WCM@3"
                }
            ],
            "view/title": [
                {
                    "command": "fluiggers-fluig-vscode-extension.addServer",
                    "when": "view == fluiggers-fluig-vscode-extension.servers",
                    "group": "navigation"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.changeServerConfigPath",
                    "when": "view == fluiggers-fluig-vscode-extension.servers",
                    "group": "navigation"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.refreshServer",
                    "when": "view == fluiggers-fluig-vscode-extension.servers",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "fluiggers-fluig-vscode-extension.deleteServer",
                    "when": "view == fluiggers-fluig-vscode-extension.servers && viewItem == serverItem",
                    "group": "inline"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.editServer",
                    "when": "view == fluiggers-fluig-vscode-extension.servers && viewItem == serverItem",
                    "group": "inline"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.deleteServer",
                    "when": "view == fluiggers-fluig-vscode-extension.servers && viewItem == serverItem"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.editServer",
                    "when": "view == fluiggers-fluig-vscode-extension.servers && viewItem == serverItem"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.datasetView",
                    "when": "view == fluiggers-fluig-vscode-extension.servers && viewItem == DatasetItem",
                    "group": "inline"
                },
                {
                    "command": "fluiggers-fluig-vscode-extension.datasetView",
                    "when": "view == fluiggers-fluig-vscode-extension.servers && viewItem == DatasetItem"
                }
            ]
        },
        "keybindings": [
            {
                "command": "fluiggers-fluig-vscode-extension.exportDataset",
                "key": "ctrl+f9",
                "mac": "cmd+f9",
                "when": "editorTextFocus && resourcePath =~ /[\\/\\\\]datasets[\\/\\\\].+$/"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportMechanism",
                "key": "ctrl+f9",
                "mac": "cmd+f9",
                "when": "editorTextFocus && resourcePath =~ /[\\/\\\\]mechanisms[\\/\\\\].+$/"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportGlobalEvent",
                "key": "ctrl+f9",
                "mac": "cmd+f9",
                "when": "editorTextFocus && resourcePath =~ /[\\/\\\\]events[\\/\\\\].+$/"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportForm",
                "key": "ctrl+f9",
                "mac": "cmd+f9",
                "when": "editorTextFocus && resourcePath =~ /[\\/\\\\]forms[\\/\\\\].+$/"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportWidget",
                "key": "ctrl+f9",
                "mac": "cmd+f9",
                "when": "editorTextFocus && resourcePath =~ /[\\/\\\\]widget[\\/\\\\].+$/"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newDataset",
                "key": "ctrl+f10",
                "mac": "cmd+f10"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newForm",
                "key": "ctrl+f11",
                "mac": "cmd+f11"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newFormEvent",
                "key": "ctrl+f12",
                "mac": "cmd+f12",
                "when": "editorTextFocus && resourcePath =~ /[\\/\\\\]forms[\\/\\\\].+$/"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.newWorkflowEvent",
                "key": "ctrl+f12",
                "mac": "cmd+f12",
                "when": "editorTextFocus && resourcePath =~ /[\\/\\\\]workflow[\\/\\\\]scripts[\\/\\\\].+\\.js$/"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportWorkflowEvent",
                "key": "ctrl+f9",
                "mac": "cmd+f9",
                "when": "editorTextFocus && resourcePath =~ /[\\/\\\\]workflow[\\/\\\\]scripts[\\/\\\\].+\\.js$/"
            },
            {
                "command": "fluiggers-fluig-vscode-extension.exportWorkflowProcess",
                "key": "ctrl+f9",
                "mac": "cmd+f9",
                "when": "editorTextFocus && resourceExtname == .process"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "fluig-config",
                    "title": "Fluig",
                    "icon": "dist/images/icon-brand.png"
                }
            ]
        },
        "views": {
            "fluig-config": [
                {
                    "id": "fluiggers-fluig-vscode-extension.servers",
                    "name": "Servidores",
                    "icon": "dist/images/icon-brand.png"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "fluiggers-fluig-vscode-extension.servers",
                "contents": "Nenhum Servidor encontrado.\n[Adicionar Servidor](command:fluiggers-fluig-vscode-extension.addServer)"
            }
        ],
        "snippets": [
            {
                "language": "html",
                "path": "./snippets/html.json"
            },
            {
                "language": "javascript",
                "path": "./snippets/javascript.json"
            },
            {
                "language": "ftl",
                "path": "./snippets/html.json"
            }
        ],
        "configuration": [
            {
                "title": "Fluiggers",
                "order": 1,
                "properties": {
                    "fluiggers.browserPath": {
                        "type": "string",
                        "description": "Caminho do seu Navegador para Autenticação MFA",
                        "default": "",
                        "scope": "machine"
                    },
                    "fluiggers.serverConfigPath": {
                        "type": "string",
                        "description": "Caminho do seu Arquivo de Configuração de Servidores",
                        "default": "",
                        "scope": "machine"
                    },
                    "fluiggers.eclipsePluginsPath": {
                        "type": "string",
                        "description": "Pasta plugins de um Fluig Studio local. Opcional quando o VSIX ja inclui os JARs do conversor ECM30",
                        "default": "",
                        "scope": "machine"
                    },
                    "fluiggers.javaPath": {
                        "type": "string",
                        "description": "Executavel Java ou pasta JAVA_HOME para o gerador ECM30. Vazio usa JAVA_HOME e depois o Java disponivel no PATH",
                        "default": "",
                        "scope": "machine"
                    },
                    "fluiggers.fluigRuntimeVersion": {
                        "type": "string",
                        "description": "Versao de compatibilidade do runtime Fluig usada pelo conversor ECM30",
                        "default": "1.8.2",
                        "scope": "machine"
                    },
                    "fluiggers.generateEcm30OnSave": {
                        "type": "boolean",
                        "description": "Gera e atualiza automaticamente o ECM30 sempre que um arquivo .process e salvo",
                        "default": true,
                        "scope": "resource"
                    },
                    "fluiggers.bpmnBackupDirectory": {
                        "type": "string",
                        "description": "Diretorio relativo a raiz do workspace usado para backups antes de editar arquivos .process",
                        "default": ".fluig-bpmn/backups",
                        "scope": "resource"
                    },
                    "fluiggers.bpmnEditorPriority": {
                        "type": "string",
                        "enum": [
                            "visual",
                            "text"
                        ],
                        "description": "Preferencia informativa do editor BPMN; use Reopen Editor With para alternar",
                        "default": "visual",
                        "scope": "resource"
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run prepare:runtime && npm run package",
        "prepare:runtime": "node scripts/prepare-fluig-runtime.js",
        "prepare:runtime:check": "node scripts/prepare-fluig-runtime.js --check",
        "package:vsix": "vsce package",
        "precompile": "gulp",
        "buildResources": "gulp buildResources",
        "buildLibraries": "gulp buildLibraries",
        "compile": "webpack",
        "watch": "npm run precompile && webpack --watch",
        "package": "npm run precompile && webpack --mode production --devtool hidden-source-map",
        "test-compile": "tsc -p ./",
